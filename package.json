  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  }
}
