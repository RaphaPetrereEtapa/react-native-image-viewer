{
  "name": "@raphapetrereetapa/react-native-image-viewer",
  "version": "1.0.0",
  "description": "Full-screen zoomable image viewer and gallery for React Native, built on Gesture Handler 3 and Reanimated 4",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index.tsx",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
